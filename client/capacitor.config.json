{
  "appId": "py.com.pasalo.app",
  "appName": "PasalO",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "automatic"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 800,
      "backgroundColor": "#f7f5f0",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
