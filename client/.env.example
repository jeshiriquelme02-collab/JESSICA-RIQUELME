# Copiá este archivo a .env.production antes de compilar la app de celular.
# En la web no hace falta: la API vive en el mismo dominio.

# Dirección pública del servidor (sin barra final)
VITE_API_URL=https://pasalo.com.py

# Dirección pública del sitio, usada en los enlaces que se comparten
VITE_PUBLIC_URL=https://pasalo.com.py
