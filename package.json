{
  "name": "pasalo",
  "private": true,
  "description": "Marketplace de segunda mano para Paraguay (estilo Vinted)",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "install:all": "npm install && npm install --prefix client",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev:server\" \"npm run dev --prefix client\"",
    "dev:server": "node --watch server/index.js",
    "build": "npm run build --prefix client -- --outDir ../dist --emptyOutDir",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "publicar": "node scripts/publicar.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.15",
    "multer": "^2.0.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
