# Variables del servidor. En desarrollo no hace falta ninguna:
# la base queda en server/data/ y las fotos en server/uploads/.

# Dirección pública del sitio (sin barra final)
PUBLIC_URL=https://pasalo.onrender.com

# Base de datos en Turso (gratis). Si no están, se usa el archivo local DB_FILE.
DB_URL=libsql://pasalo-tuusuario.turso.io
DB_AUTH_TOKEN=eyJ...

# Fotos en Cloudinary (gratis). Si no está, se guardan en UPLOAD_DIR.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
